					<Parameter>
						<Name><![CDATA[quantity]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rate]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[from]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[to]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[//countinside += quantity;
//Agent from = getOwner();
//ship in portions, according to shipment size
while(quantity>0) {
	double shipmentquantity = min(VehicleCapacity, quantity);
	quantity -= shipmentquantity;
	processShipment.take(new Order(shipmentquantity, rate, from, to));
}
]]></Body>
				</Function>
