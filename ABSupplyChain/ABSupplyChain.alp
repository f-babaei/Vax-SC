					<Action><![CDATA[int currentDay = (int) time(); // Assuming time() is in days
double severity = 1.0 - (( (double) currentDay - (double) disruptionStart) / ((double) disruptionEnd - (double) disruptionStart)); // fades over time

if (currentDay >= disruptionStart && currentDay < disruptionEnd) {
   // Disruption is active
   // Apply effects: reduce throughput, delay orders, etc.
   //traceln();
   for (VaxLocalDistributor vd : affectedDHOCollection) {
    vd.ShippingDept.set_VehicleSpeed(0.5);//+55*(1-severity)); 
    
    }
    
   //log("Disruption active on day " + currentDay);
}
else {
for (VaxLocalDistributor vd : affectedDHOCollection) {
    vd.ShippingDept.VehicleSpeed = 55;
    }
    }]]></Action>
				</Event>
