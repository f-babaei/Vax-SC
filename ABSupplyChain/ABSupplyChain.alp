			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777628733221</Id>
					<Name><![CDATA[flatten]]></Name>
					<X>-120</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (int dose : allowedCombos.keySet()) {
        for (int r : allowedCombos.get(dose)) {
            doseList.add(dose);
            rolloutList.add(r);
        }
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777628733223</Id>
					<Name><![CDATA[plotCurves]]></Name>
					<X>-120</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[allHistories]]></Name>
						<Type><![CDATA[ArrayList<ArrayList<double[]>>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plot]]></Name>
						<Type><![CDATA[TimePlot]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[int runs = allHistories.size();

for (int r = 0; r < runs; r++) {

    int T = allHistories.get(r).size();   // length for THIS run
    double[] curve = new double[T];

    for (int t = 0; t < T; t++) {
        double[] snapshot = allHistories.get(r).get(t);
        //curve[t] = Arrays.stream(snapshot).sum();//.orElse(0);
        switch (mode) {
        case "sum":
            curve[t] = Arrays.stream(snapshot).sum();
            break;
        case "avg":
            curve[t] = Arrays.stream(snapshot).average().orElse(0);
            break;
        default:
            throw new IllegalArgumentException("Unknown mode: " + mode);
    }
    }

    // Create dataset sized for THIS run
    DataSet ds = new DataSet(T);

    for (int t = 0; t < T; t++) {
        ds.add(t, curve[t]);
    }
    Color col = Color.getHSBColor((float) r / runs, 1f, 1f);
    
    plot.addDataSet(
    ds,
    "Rollout " + rolloutList.get(r) + " | Total Doses " + doseList.get(r),
    col,
    true,   // show line
    false,  // show points
    Chart.INTERPOLATION_LINEAR,
    3.0,    // point size (ignored if showPoints=false)
    Chart.POINT_CIRCLE
);
    
    
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777628733225</Id>
					<Name><![CDATA[setupMap]]></Name>
					<X>-120</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[allowedCombos.put(2600, new int[]{371});
allowedCombos.put(13000, new int[]{1857});
allowedCombos.put(26000, new int[]{2500, 3714});
allowedCombos.put(130000, new int[]{2500, 5000, 10000, 18571});
allowedCombos.put(260000, new int[]{2500, 5000, 10000, 20000});
allowedCombos.put(520000, new int[]{2500, 5000, 10000, 20000});]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777644066655</Id>
					<Name><![CDATA[plotCurve]]></Name>
					<X>-120</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[history]]></Name>
						<Type><![CDATA[ArrayList<double[]>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[plot]]></Name>
						<Type><![CDATA[TimePlot]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[r]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[
int T = history.size();          // number of timesteps in THIS run
DataSet ds = new DataSet(T);     // dataset sized for this run

for (int t = 0; t < T; t++) {
    double[] snapshot = history.get(t);

    double value;
    switch (mode) {
        case "sum":
            value = Arrays.stream(snapshot).sum();
            break;

        case "avg":
            value = Arrays.stream(snapshot).average().orElse(0);
            break;

        default:
            throw new IllegalArgumentException("Unknown mode: " + mode);
    }

    ds.add(t, value);
}

Color col = sharedColors[r];

// Add to TimePlot (must use full signature)
plot.addDataSet(
    ds,
    "Rollout " + rolloutList.get(r) + " | Total Doses " + doseList.get(r),   // auto label
    col,
    true,                                  // show line
    Chart.INTERPOLATION_LINEAR,
    1.5,
    Chart.POINT_NONE
);
]]></Body>
				</Function>
			</Functions>

