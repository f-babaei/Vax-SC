							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!onOrder) {
Order o = new Order(max(DVO, VSS*DVO/ROT), DVO/ROT, this, null);
// Sending message
linkToDistributor.send(o);
//traceln(time());
onOrder = true;
DVO -= o.amount;
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755790360424</Id>
					<Name><![CDATA[prFunc]]></Name>
					<X>780</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (cf){
return min(1, 1-0.015*(TFunc(time(DAY))-25));}
else {return 1;}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755790360426</Id>
					<Name><![CDATA[processDSOrder]]></Name>
					<X>60</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[orderMsg]]></Name>
						<Type><![CDATA[Order]]></Type>
					</Parameter>
					<Body><![CDATA[//Need to be implemented with better details like tracking the downstream performance or 
//add a feature to order agent to determine type of shipping
CurrentMean = (ShippingDept.VehicleSpeed>50)?ShippingDept:ExpressShipping;
//CurrentMean = ShippingDept;
VOB += orderMsg.amount;
//updating the order rate based on the maximum observed value from different message sources
//this is a conservative implementation like H_inf, we may use avg values like H_2
if (orderMsg.to == null) {
vaxOrderRate = max(vaxOrderRate, orderMsg.amountRate);}
double realisedShipment = min(RSV, orderMsg.amount);
double realisedRate = vaxSupplyRate;
RSV -= realisedShipment;
if (orderMsg.to == null) {
CurrentMean.ship(realisedShipment, realisedRate, null, orderMsg.from);}
else {CurrentMean.ship(realisedShipment, realisedRate, this, orderMsg.from);}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1755790360428</Id>
					<Name><![CDATA[processShipment]]></Name>
					<X>60</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[shipmentMsg]]></Name>
						<Type><![CDATA[Order]]></Type>
					</Parameter>
					<Body><![CDATA[VI += shipmentMsg.amount;
onOrder = false;
//traceln(time());]]></Body>
				</Function>
			</Functions>
