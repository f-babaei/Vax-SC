			<Events>
				<Event>
					<Id>1749655163922</Id>
					<Name><![CDATA[order]]></Name>
					<X>60</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[ROT]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_YEAR]]></Unit>
						</Rate>
						<Id>1749655163920</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1749283200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[ROT]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[ROT]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!onOrder) {
Order o = new Order(max(DVO, VSS*DVO/ROT), DVO/ROT, this, null);
// Sending message
linkToManufacturer.send(o);
onOrder = true;
DVO -= o.amount;
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1749222671373</Id>
					<Name><![CDATA[prFunc]]></Name>
					<X>780</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (cf){
return min(1, 1-0.015*(TFunc(time(DAY))-25));}
else {return 1;}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1751277090257</Id>
					<Name><![CDATA[processDSOrder]]></Name>
					<X>60</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[orderMsg]]></Name>
						<Type><![CDATA[Order]]></Type>
					</Parameter>
					<Body><![CDATA[VOB += orderMsg.amount;
//updating the order rate based on the maximum observed value from different message sources
//this is a conservative implementation like H_inf, we may use avg values like H_2
vaxOrderRate = max(vaxOrderRate, orderMsg.amountRate);
double realisedShipment = min(RSV, orderMsg.amount);
//double realisedShipment = min(VI, orderMsg.amount);
double realisedRate = vaxSupplyRate;
RSV -= realisedShipment;
ShippingDept.ship(realisedShipment, realisedRate, this, orderMsg.from);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1751384411033</Id>
					<Name><![CDATA[processShipment]]></Name>
					<X>60</X><Y>70</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[shipmentMsg]]></Name>
						<Type><![CDATA[Order]]></Type>
					</Parameter>
					<Body><![CDATA[VI += shipmentMsg.amount;
onOrder = false;
//traceln(time());]]></Body>
				</Function>
			</Functions>
