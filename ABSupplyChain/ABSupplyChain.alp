					<Parameter>
						<Name><![CDATA[viewIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[ViewArea targetArea = null;
switch (viewIndex) {
	case 0:
		targetArea = viewAreaMap;
		break;
	case 1:
		targetArea = viewAreaStats;
		break;
	case 2:
		targetArea = viewAreaGraph;
		break;
	default:
}

targetArea.navigateTo();
uiBar.setPos(targetArea.getX(), targetArea.getY(), 0);
currentViewIndex = viewIndex;]]></Body>
