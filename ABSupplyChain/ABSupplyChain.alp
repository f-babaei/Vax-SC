			<Functions>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Number[]]]></ReturnType>
					<Id>1738342855452</Id>
					<Name><![CDATA[getObservation]]></Name>
					<X>240</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (time() == 0) {
  return new Number[]{0, 0, 0};
} else {
return new Number[] {
	biofuelSC.state[0],
	biofuelSC.state[1],
	biofuelSC.state[2]
};
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1738342855454</Id>
					<Name><![CDATA[takeAction]]></Name>
					<X>240</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[RLAction]]></Type>
					</Parameter>
					<Body><![CDATA[// Perform action
if (time() == 0) {
  // Do nothing
} else {
switch (action.getIntAction()) {

	case 0:
		biofuelSC.changeSubsidyLevel(0);
		break;
	
	case 1:
		biofuelSC.changeSubsidyLevel(1);
		break;
	
	case 2:
		biofuelSC.changeSubsidyLevel(2);
		break;
		
	case 3:
		biofuelSC.changeSubsidyLevel(3);
		break;
	
	case 4:
		biofuelSC.changeSubsidyLevel(4);
		break;
	
	case 5:
		biofuelSC.changeSubsidyLevel(5);
		break;
	
	default:
		throw new AssertionError("Action is none of the defined. It should never "
								 + "enter this stage");
}

// Check if cartpole has reached max steps
// or has reached limits. Then end game
// Are limits exceeded?
boolean exeedTimeLim = time() == getEngine().getStopTime();
reward = biofuelSC.scPayoff();
// Rewards and completion
if (exeedTimeLim) {
	// Set reward
	done = true;
}

// Accumulate total reward
totReward += reward;
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1738342855456</Id>
					<Name><![CDATA[getReward]]></Name>
					<X>240</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (time() == 0) {
  return 0;
} else {
return reward;
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
