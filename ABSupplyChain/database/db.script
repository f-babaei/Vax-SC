CREATE USER SA PASSWORD DIGEST 'd41d8cd98f00b204e9800998ecf8427e'
ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.AL_CONFIGURATION(PROPERTY_NAME VARCHAR(255) NOT NULL,PROPERTY_VALUE VARCHAR(16777216),UNIQUE(PROPERTY_NAME))
CREATE MEMORY TABLE PUBLIC.AL_GROUPS(GROUP_NAME VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_TABLES(TABLE_NAME VARCHAR(255) NOT NULL PRIMARY KEY,GROUP_NAME VARCHAR(255),DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_CUSTOM_TYPE(TABLE_NAME VARCHAR(255),COLUMN_NAME VARCHAR(255),TYPE VARCHAR(255),NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.AL_VIEWS(VIEW_NAME VARCHAR(255) NOT NULL,VIEW_DEFINITION VARCHAR(16777216),IS_VALID BOOLEAN,UNIQUE(VIEW_NAME))
CREATE MEMORY TABLE PUBLIC.AL_SELECTED_LOG_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.AL_DB_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),USAGE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.PROVINCIAL_PUBLIC_HEALTH(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(16777216),TYPE VARCHAR(16777216),LATITUDE DOUBLE,LONGITUDE DOUBLE,UPSTREAM_CONNECTION VARCHAR(16777216),INITIAL_DEMAND DOUBLE)
ALTER TABLE PUBLIC.PROVINCIAL_PUBLIC_HEALTH ALTER COLUMN AL_ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.NATIONAL_OFFICE(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(16777216),TYPE VARCHAR(16777216),LATITUDE DOUBLE,LONGITUDE DOUBLE,INITIAL_DEMAND DOUBLE)
ALTER TABLE PUBLIC.NATIONAL_OFFICE ALTER COLUMN AL_ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.DISTRICT_HEALTH_OFFICE(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(16777216),TYPE VARCHAR(16777216),LATITUDE DOUBLE,LONGITUDE DOUBLE,UPSTREAM_CONNECTION VARCHAR(16777216),INITIAL_DEMAND DOUBLE)
ALTER TABLE PUBLIC.DISTRICT_HEALTH_OFFICE ALTER COLUMN AL_ID RESTART WITH 18
CREATE MEMORY TABLE PUBLIC.PUSKESMAS(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NAME VARCHAR(16777216),PROVINCE VARCHAR(16777216),LATITUDE DOUBLE,LONGITUDE DOUBLE,UPSTREAM_CONNECTION VARCHAR(16777216),ANNUAL_DEMAND DOUBLE,INITIAL_DEMAND DOUBLE)
ALTER TABLE PUBLIC.PUSKESMAS ALTER COLUMN AL_ID RESTART WITH 18
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CHARACTER_DATA TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.SQL_IDENTIFIER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.TIME_STAMP TO PUBLIC
GRANT DBA TO SA
SET SCHEMA SYSTEM_LOBS
