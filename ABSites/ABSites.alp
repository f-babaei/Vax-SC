			<Events>
				<Event>
					<Id>1749225031384</Id>
					<Name><![CDATA[order]]></Name>
					<X>60</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MONTH]]></Unit>
						</Rate>
						<Id>1749225031382</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1749283200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[ROT]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[ROT]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[//VI += max(0, DVO);//order DVO if DVO>0
if (!onOrder) {
//traceln(DVO/ROT-DesiredVaxDelivery);
//Order o = new Order(DVO, DesiredVaxDelivery, this, null);

Order o = new Order(max(DVO, VSS*DVO/ROT), DVO/ROT, this, null);

// Sending message
linkToDistributor.send(o);
onOrder = true;

DVO -= o.amount;
}]]></Action>
				</Event>
				<Event>
					<Id>1756283615991</Id>
					<Name><![CDATA[emergencyOrder]]></Name>
					<X>230</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MONTH]]></Unit>
						</Rate>
						<Id>1756283615989</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1749283200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[3.5]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[3.5]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[InventoryCoverageRatio<VSS & !onEmergencyOrder]]></Condition>
					</Properties>
					<Action><![CDATA[//VI += max(0, DVO);//order DVO if DVO>0
if (VSS>InventoryCoverageRatio & !onEmergencyOrder) {
double EOT = order.getRest(DAY);
double orderAmount = min(DVO, max(VSS, EOT)*vaxOrderRate);
//VI += orderAmount;

Order o = new Order(orderAmount, 0, this, this);
linkToDistributor.send(o);
onEmergencyOrder = true;
DVO -= orderAmount;
}

//Order o = new Order(DVO, DesiredVaxDelivery, this, null);
//Order o = new Order(DVO, DVO/ROT, this, null);

// Sending message
//linkToDistributor.send(o);


//DVO -= o.amount;
//}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
