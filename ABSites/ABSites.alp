			</Parameters>
			<StartupCode><![CDATA[VSS *= ResCoeff;

vaxOrderRate = Capacity/52/2/(7/2);

VOB = vaxOrderRate*TDD;
EVDR = vaxOrderRate;
VI = vaxOrderRate*(VSS+MOPT+ROT*1/3);
DVO = EVDR;

StorageCapacity = 6*7*vaxOrderRate; // six weeks of average daily order]]></StartupCode>
