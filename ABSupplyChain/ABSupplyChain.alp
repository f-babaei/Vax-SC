		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1749222362300">
			<Id>1777477298526</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[allHistories_HA_ofr = new ArrayList<>();
allHistories_HA_vi = new ArrayList<>();

allowedCombos = new LinkedHashMap<>();
doseList = new ArrayList<>();
rolloutList = new ArrayList<>();

int totalRuns = getMaximumIterations();
sharedColors = new Color[totalRuns];
for (int i = 0; i < totalRuns; i++) {
    sharedColors[i] = Color.getHSBColor((float) i / totalRuns, 1f, 1f);
}

setupMap();
flatten();]]></InitialSetupCode>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeSimulationRunCode><![CDATA[//traceln("givenTime" + root.TotalDose/root.GlobalRollout);]]></BeforeSimulationRunCode>
			<AfterSimulationRunCode><![CDATA[allHistories_HA_ofr.add(root.HA_ofr_history);
allHistories_HA_vi.add(root.HA_vi_history);

plotCurve(root.HA_vi_history, plot2, "sum", getCurrentIteration()-1);
plotCurve(root.HA_ofr_history, plot3, "sum", getCurrentIteration()-1);
plotCurve(root.HZ_ofr_history, plot4, "sum", getCurrentIteration()-1);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
