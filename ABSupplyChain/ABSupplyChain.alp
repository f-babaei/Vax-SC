				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777638066512</Id>
					<Name><![CDATA[saveStats]]></Name>
					<X>160</X><Y>1380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    File file = new File("C:/Users/fc1fb/Downloads/HZ_ofr_history.csv");
    PrintWriter pw = new PrintWriter(file);

    // Loop through each snapshot
    for (double[] snapshot : HZ_ofr_history) {
        // Convert array to comma-separated string
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < snapshot.length; i++) {
            sb.append(snapshot[i]);
            if (i < snapshot.length - 1) sb.append(",");
        }
        pw.println(sb.toString());
    }

    pw.close();
    traceln("Export complete: " + file.getAbsolutePath());

} catch (Exception e) {
    e.printStackTrace();
}
